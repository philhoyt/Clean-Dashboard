{
    "name": "philhoyt/wp-dashboard-cleanup",
    "description": "Removes noise from the WordPress admin dashboard.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "yahnis-elsts/plugin-update-checker": "^5.5"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.4.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpunit/phpunit": "^13.1",
        "brain/monkey": "^2.7"
    },
    "scripts": {
        "post-install-cmd": "@php scripts/copy-puc.php",
        "post-update-cmd": "@php scripts/copy-puc.php",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "i18n": "wp i18n make-pot . languages/wp-dashboard-cleanup.pot --slug=wp-dashboard-cleanup --domain=wp-dashboard-cleanup --exclude=lib,vendor,tests,scripts,dist,plans,node_modules"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
